# =============================================================================
# HaqFlow — environment variables
# Copy this file to .env (repo root, or backend/.env / frontend/.env) and fill
# in real values. Never commit the filled-in .env file — only this example.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (backend/.env or exported in your shell / hosting provider)
# -----------------------------------------------------------------------------

# Required. Get a key at https://console.groq.com
GROQ_API_KEY="MY_GROQ_API_KEY"

# Optional — defaults shown. Override to point at a different Groq model.
# IMPORTANT: Groq regularly deprecates/decommissions model IDs. If answers
# stop coming back with a valid key, this is the first thing to check —
# see https://console.groq.com/docs/models and
# https://console.groq.com/docs/deprecations for the current list.
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_VISION_MODEL="qwen/qwen3.6-27b"

# Comma-separated list of origins allowed to call the API (CORS).
# "*" (default) allows any origin, which is fine since this API never uses
# cookies/credentials. For tighter production security, set this to your
# exact deployed frontend URL(s), e.g.:
# CORS_ALLOW_ORIGINS="https://haqflow.vercel.app,http://localhost:5173"
CORS_ALLOW_ORIGINS="*"

# "development" | "production" — informational, surfaced on GET /health.
APP_ENV="development"

# -----------------------------------------------------------------------------
# Frontend (frontend/.env)
# -----------------------------------------------------------------------------

# Base URL of the FastAPI backend. Leave BLANK (or unset) to force mock mode
# regardless of VITE_USE_MOCK below.
VITE_API_BASE_URL="http://localhost:8000"

# "true"  -> always use the in-memory mock, even if VITE_API_BASE_URL is set.
# "false" -> call the real backend at VITE_API_BASE_URL.
# Unset / anything else with no VITE_API_BASE_URL -> defaults to mock.
VITE_USE_MOCK="false"
